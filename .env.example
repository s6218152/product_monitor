DATABASE_PATH=data/facebook_monitor.db
MARKETPLACE_LOCATION=Taiwan
MARKETPLACE_RADIUS_KM=200
LOG_LEVEL=INFO

# Dedicated Playwright profile; never point this at your normal Chrome profile.
FACEBOOK_PROFILE_DIR=.facebook-profile
FACEBOOK_HEADLESS=false
MARKETPLACE_MAX_SCROLLS=3

# Create a bot with @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
